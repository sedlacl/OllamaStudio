{
  "name": "ollamastudio",
  "version": "1.4.2",
  "description": "OllamaStudio — desktopový hostitel Ollama a TabbyAPI",
  "main": "./out/main/index.js",
  "author": "OllamaStudio",
  "license": "MIT",
  "homepage": "https://github.com/sedlacl/OllamaStudio",
  "repository": {
    "type": "git",
    "url": "https://github.com/sedlacl/OllamaStudio.git"
  },
  "scripts": {
    "dev": "node ./scripts/electron-vite.mjs dev",
    "build": "node ./scripts/electron-vite.mjs build",
    "lint": "tsc --noEmit -p tsconfig.node.json --tsBuildInfoFile node_modules/.vite/tsconfig.node.tsbuildinfo && tsc --noEmit -p tsconfig.web.json --tsBuildInfoFile node_modules/.vite/tsconfig.web.tsbuildinfo",
    "preview": "node ./scripts/electron-vite.mjs preview",
    "test": "vitest run",
    "test:security": "vitest run electron/security/adversarial-redaction.test.ts electron/security/secret-redactor.test.ts electron/security/log-scrub.test.ts electron/security/studio-log-persistence.test.ts electron/ollama/log-buffer-redaction.test.ts electron/tabby/download-session-helpers.test.ts electron/tabby/runtime-patch.test.ts",
    "patch:tabby": "node ./scripts/apply-tabby-downloader-patch.mjs",
    "postinstall": "electron-builder install-app-deps",
    "icons": "node ./scripts/make-icons.mjs build/icon-source.png --fit --transparent",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.ollamastudio.app",
    "productName": "OllamaStudio",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "build/icon.ico",
      "build/icon-256.png"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon-256.png",
      "category": "Utility",
      "maintainer": "OllamaStudio <sedlacl@users.noreply.github.com>"
    }
  }
}

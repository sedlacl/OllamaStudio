{
  "name": "ollamastudio",
  "version": "1.1.0",
  "description": "OllamaStudio — desktopový hostitel ollama serve",
  "main": "./out/main/index.js",
  "author": "OllamaStudio",
  "license": "MIT",
  "scripts": {
    "dev": "node ./scripts/electron-vite.mjs dev",
    "build": "node ./scripts/electron-vite.mjs build",
    "preview": "node ./scripts/electron-vite.mjs preview",
    "postinstall": "electron-builder install-app-deps",
    "icons": "node ./scripts/make-icons.mjs build/icon-source.png --fit --transparent",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.ollamastudio.app",
    "productName": "OllamaStudio",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "build/icon.ico",
      "build/icon-256.png"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
